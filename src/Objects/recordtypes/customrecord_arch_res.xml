<customrecordtype scriptid="customrecord_arch_res">
  <!--
    CWP ARCH pre-arrival bundle reservation, Feedback 8 steps 2.1 and 2.5b.

    ONE RECORD PER RESERVED BUNDLE, and it IS the reservation. Its externalId is
    the lot (inventorynumber) internal id, so NetSuite's uniqueness rule on
    externalId is the lock: a second trader's create for the same bundle is
    refused by the platform, not by a check-then-act in our code. Nothing else in
    NetSuite offers an atomic claim (no compare-and-set on a field, no mutex).

    The four custitemnumber_arch_res_* lot fields are a MIRROR written by the
    reconciler, for the lot record and an Inventory Number saved search. Readers
    that decide sellability read THIS record.

    Lifecycle: the order endpoint creates it with the lot and item before the SO
    saves (no SO id or line key exists yet), then sets SO and line key after.
    A claim with no SO is "pending"; one left pending by a crash is swept by the
    reconciler. Released by deleting it: un-reserve, void SO, deleted SO line,
    receipt hand-off once the SO line's inventory detail covers it.

    accesstype NONENEEDED, like customrecord_mgsl_inventory_hold: the endpoint
    runs as customrole2184, which holds no custom-record grant for a new type.
  -->
  <accesstype>NONENEEDED</accesstype>
  <allowattachments>F</allowattachments>
  <allowinlinedeleting>F</allowinlinedeleting>
  <allowinlinedetaching>F</allowinlinedetaching>
  <allowinlineediting>F</allowinlineediting>
  <allowmobileaccess>F</allowmobileaccess>
  <allownumberingoverride>F</allownumberingoverride>
  <allowquickadd>F</allowquickadd>
  <allowquicksearch>T</allowquicksearch>
  <allowuiaccess>T</allowuiaccess>
  <description>CWP ARCH pre-arrival bundle reservation. One record per reserved bundle; its External ID is the lot internal id, which is what stops two Sales Orders reserving the same bundle. Written by the ARCH order endpoint, released by the ARCH reservation reconciler. Deleting one releases the bundle.</description>
  <enablekeywords>F</enablekeywords>
  <enablenumbering>T</enablenumbering>
  <enableoptimisticlocking>T</enableoptimisticlocking>
  <enablesystemnotes>T</enablesystemnotes>
  <externalrolepermissionlevel>NONE</externalrolepermissionlevel>
  <hierarchical>F</hierarchical>
  <icon></icon>
  <iconbuiltin>T</iconbuiltin>
  <iconindex>30</iconindex>
  <includeinsearchmenu>T</includeinsearchmenu>
  <includename>F</includename>
  <isinactive>F</isinactive>
  <isordered>F</isordered>
  <numberinginit>1</numberinginit>
  <numberingmindigits>4</numberingmindigits>
  <numberingprefix>RES-</numberingprefix>
  <numberingsuffix></numberingsuffix>
  <publicpermissionlevel>NONE</publicpermissionlevel>
  <recordname>ARCH Bundle Reservation</recordname>
  <showcreationdate>T</showcreationdate>
  <showcreationdateonlist>T</showcreationdateonlist>
  <showid>T</showid>
  <showlastmodified>T</showlastmodified>
  <showlastmodifiedonlist>T</showlastmodifiedonlist>
  <shownotes>F</shownotes>
  <showowner>T</showowner>
  <showownerallowchange>F</showownerallowchange>
  <showowneronlist>T</showowneronlist>
  <customrecordcustomfields>
    <customrecordcustomfield scriptid="custrecord_arch_res_lot">
      <accesslevel>2</accesslevel>
      <allowquickadd>F</allowquickadd>
      <applyformatting>F</applyformatting>
      <checkspelling>F</checkspelling>
      <defaultchecked>F</defaultchecked>
      <defaultselection></defaultselection>
      <defaultvalue></defaultvalue>
      <description>The reserved bundle (Inventory Number). Always equal to this record's External ID.</description>
      <displaytype>NORMAL</displaytype>
      <dynamicdefault></dynamicdefault>
      <encryptatrest>F</encryptatrest>
      <fieldtype>SELECT</fieldtype>
      <globalsearch>F</globalsearch>
      <help>The bundle this reservation holds.</help>
      <isformula>F</isformula>
      <ismandatory>F</ismandatory>
      <isparent>F</isparent>
      <label>Bundle</label>
      <linktext></linktext>
      <onparentdelete>NO_ACTION</onparentdelete>
      <rolerestrict>F</rolerestrict>
      <searchcomparefield></searchcomparefield>
      <searchdefault></searchdefault>
      <searchlevel>2</searchlevel>
      <selectrecordtype>-266</selectrecordtype>
      <showinlist>T</showinlist>
      <sourcefilterby></sourcefilterby>
      <sourcefrom></sourcefrom>
      <sourcelist></sourcelist>
      <storevalue>T</storevalue>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_arch_res_item">
