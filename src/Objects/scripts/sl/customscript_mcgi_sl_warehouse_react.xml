<suitelet scriptid="customscript_mcgi_sl_warehouse_react">
  <description>CWP ARCH warehouse bundle-split queue. Separate deployment from the trader screen so access can be restricted by role.</description>
  <isinactive>F</isinactive>
  <name>MCGI SL Warehouse Screen React</name>
  <notifyadmins>F</notifyadmins>
  <notifyemails>aserban@houseblend.io</notifyemails>
  <!-- Notifications go to Andrei ONLY while ARCH is being built.
       notifyowner=T sent them to the script owner, "House Blend 2"
       (credentials.ns_mcg2@houseblend.io) — a shared HouseBlend
       credentials mailbox, so the person actually building this never
       saw them. notifyadmins stays F: MGSL admins must not be paged by
       our in-progress work. -->
  <notifyowner>F</notifyowner>
  <notifyuser>F</notifyuser>
  <scriptfile>[/SuiteScripts/mcgi_services/trader_screen/entry_points/sl/mcgi_sl_warehouse_screen_react.js]</scriptfile>
  <scriptdeployments>
    <scriptdeployment scriptid="customdeploy_mcgi_sl_warehouse_react">
      <allemployees>T</allemployees>
      <allpartners>F</allpartners>
      <allroles>F</allroles>
      <audslctrole></audslctrole>
      <eventtype></eventtype>
      <isdeployed>T</isdeployed>
      <isonline>F</isonline>
      <loglevel>DEBUG</loglevel>
      <runasrole></runasrole>
      <status>RELEASED</status>
      <title>MCGI SL Warehouse Screen React</title>
    </scriptdeployment>
  </scriptdeployments>
</suitelet>
